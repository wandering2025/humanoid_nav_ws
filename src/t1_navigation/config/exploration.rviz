Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 233; 239; 242
    Fixed Frame: map
    Frame Rate: 15
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground z=0
    Enabled: false
    Cell Size: 0.5
    Plane Cell Count: 40
    Reference Frame: odom
  - Class: rviz_default_plugins/RobotModel
    Name: Booster T1
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
  - Class: rviz_default_plugins/Axes
    Name: base_link axes
    Enabled: false
    Reference Frame: base_link
    Length: 0.3
    Radius: 0.025
  - Class: rviz_default_plugins/Odometry
    Name: Ideal truth odom
    Enabled: false
    Topic:
      Value: /odom
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 10
    Keep: 20
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Shape: Arrow
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Axes: false
    Show Arrows: false
    Show Names: false
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR returns
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (m): 0.035
    Style: Points
    Color Transformer: FlatColor
    Color: 220; 30; 30
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR SLAM map
    Enabled: true
    Alpha: 1.0
    Topic:
      Value: /t1/viz/map_cells
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Style: Squares
    Size (m): 0.05
    Color Transformer: RGB8
    Position Transformer: XYZ
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Global costmap
    Enabled: false
    Alpha: 0.2
    Topic:
      Value: /t1/viz/global_cells
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Style: Squares
    Size (m): 0.05
    Color Transformer: RGB8
    Position Transformer: XYZ
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Local obstacle costs
    Enabled: true
    Alpha: 0.34
    Topic:
      Value: /t1/viz/local_cells
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Style: Squares
    Size (m): 0.05
    Color Transformer: RGB8
    Position Transformer: XYZ
    Decay Time: 0
  - Class: rviz_default_plugins/Path
    Name: Live Nav2 plan (blue)
    Enabled: true
    Color: 25; 90; 220
    Line Style: Billboards
    Line Width: 0.09
    Topic:
      Value: /t1/viz/live_plan
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Polygon
    Name: Stop boundary 1.65 m
    Enabled: true
    Color: 220; 0; 0
    Topic:
      Value: /safety/stop_zone
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Polygon
    Name: Slow boundary 1.95 m
    Enabled: true
    Color: 230; 160; 0
    Topic:
      Value: /safety/slow_zone
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/Pose
    Name: Navigation goal
    Enabled: false
    Color: 0; 160; 0
    Shape: Arrow
    Topic:
      Value: /goal_pose
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/PoseWithCovariance
    Name: AMCL localization
    Enabled: false
    Topic:
      Value: /amcl_pose
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
    Shape: Arrow
  - Class: rviz_default_plugins/Polygon
    Name: Planning footprint
    Enabled: true
    Color: 20; 180; 110
    Topic:
      Value: /local_costmap/published_footprint
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/MarkerArray
    Name: Mission status, targets and actual trail
    Enabled: true
    Topic:
      Value: /t1/viz/demo
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 34.0
      Pitch: 1.5707
      Yaw: -1.5708
      Focal Point:
        X: 7.0
        Y: 4.0
        Z: 0.55
      Target Frame: map
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1024
  Height: 740
