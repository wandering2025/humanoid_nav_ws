<!--
  W11 NavigateToPose tree, from the installed Jazzy
  navigate_w_replanning_only_if_path_becomes_invalid.xml plus the bounded
  clear-costmap/wait recovery of navigate_to_pose_w_replanning_and_recovery.xml.
  No spin/backup: W05 forbids reverse; in-place turns only come from the
  controller inside the calibrated band.
  Replanning happens on a new goal, when the current path becomes invalid in the
  costmap (e.g. newly scanned blockage), or when the path is 5 s old. Periodic
  1 Hz replanning flipped between the two equal island detours and re-triggered
  in-place turns; never replanning left MPPI (no reverse) stuck with the goal
  behind it after an overshoot. A 5 s refresh lets RotationShim re-align (W11 C2).
  The goal tool adds the 120 s simulation-time limit and cancels on expiry.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Fallback>
            <ReactiveSequence>
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <Inverter>
                <PathExpiringTimer seconds="5.0" path="{path}"/>
              </Inverter>
              <IsPathValid path="{path}"/>
            </ReactiveSequence>
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </Fallback>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence name="RecoveryActions">
        <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        <Wait wait_duration="2.0"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
